{
  "title": "CDC Pipeline",
  "uid": "cdc-pipeline",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag (messages waiting)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "max(kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "max lag" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "End-to-end latency (DB commit to published event)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(cdc_end_to_end_latency_seconds_bucket[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(cdc_end_to_end_latency_seconds_bucket[1m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(cdc_end_to_end_latency_seconds_bucket[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput by change type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (change_type) (rate(cdc_events_processed_total[1m]))", "legendFormat": "{{change_type}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processing time per event (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(cdc_processing_time_seconds_bucket[1m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed processing attempts by exception",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (exception) (rate(cdc_processing_failures_total[1m]))", "legendFormat": "{{exception}}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Dead letters (last 15 minutes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(cdc_events_dead_lettered_total[15m])) or vector(0)", "legendFormat": "dead letters" }
      ]
    }
  ]
}