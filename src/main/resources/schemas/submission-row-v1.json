{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/submission-row-v1.json",
  "title": "submissions table row as emitted by Debezium (v1)",
  "type": "object",
  "required": ["id", "student_id", "course_id", "assignment_id", "status", "submitted_at"],
  "properties": {
    "id":            { "type": "integer" },
    "student_id":    { "type": "string", "minLength": 1 },
    "course_id":     { "type": "string", "minLength": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "score":         { "type": ["number", "null"] },
    "status":        { "enum": ["SUBMITTED", "GRADED", "RETURNED"] },
    "submitted_at":  { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}