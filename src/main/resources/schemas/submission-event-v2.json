{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/submission-event-v2.json",
  "title": "SubmissionEvent v2",
  "description": "Adds optional lateMinutes. Backward compatible with v1; consumers should be tolerant readers.",
  "type": "object",
  "required": ["eventId", "schemaVersion", "changeType", "submissionId", "studentId",
    "courseId", "assignmentId", "status", "submittedAt", "occurredAt"],
  "properties": {
    "eventId":       { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "changeType":    { "enum": ["CREATED", "UPDATED", "DELETED", "SNAPSHOT"] },
    "submissionId":  { "type": "integer" },
    "studentId":     { "type": "string", "minLength": 1 },
    "courseId":      { "type": "string", "minLength": 1 },
    "assignmentId":  { "type": "string", "minLength": 1 },
    "score":         { "type": "number", "minimum": 0, "maximum": 100 },
    "status":        { "enum": ["SUBMITTED", "GRADED", "RETURNED"] },
    "lateMinutes":   { "type": "integer", "minimum": 0 },
    "submittedAt":   { "type": "string", "format": "date-time" },
    "occurredAt":    { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}